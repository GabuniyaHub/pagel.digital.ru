<header class="pl-header">
  <nav class="pl-header-inner" aria-label="Основная навигация">
    <a class="pl-brand" href="/pages/index.html" aria-label="PL-GL — Главная"><img src="/assets/images/pl-gl-logo.svg" alt="PL-GL" width="132" height="40"></a>
    <a class="pl-home" href="/pages/index.html">Каталог</a>
    <div class="pl-header-actions">
      <a class="pl-button pl-header-sell" href="<%= sellUrl %>" aria-label="Разместить объявление" title="Разместить объявление"><span aria-hidden="true">＋</span> Разместить объявление</a>
      <span class="plgl-notification-slot"><button class="plgl-notification-toggle" type="button" aria-label="Уведомления" aria-expanded="false"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9Z"/><path d="M10 21h4"/></svg></button></span>
      <div class="pl-profile">
        <button id="profile-menu-toggle" class="pl-profile-toggle" type="button" aria-label="Меню профиля" aria-expanded="false" aria-controls="profile-menu"><img id="header-avatar" src="/assets/images/pl-gl-default-avatar.svg" alt="" width="36" height="36"><span id="header-user-name">Профиль</span><span class="pl-chevron" aria-hidden="true"></span></button>
        <div class="pl-profile-dropdown" id="profile-menu" hidden>
          <a href="/account#profile">Личный кабинет</a>
          <a href="/account#settings">Настройки профиля</a>
          <button type="button" class="select-favorites">Избранное</button>
          <a href="#" class="settings-link">Безопасность аккаунта</a>
          <button id="catalog-logout" type="button">Выйти</button>
        </div>
      </div>
    </div>
  </nav>
</header>
