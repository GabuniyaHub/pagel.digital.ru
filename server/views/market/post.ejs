<!-- UP -->
<script>
  function timeAgo(date) {
    const now = new Date();
    const seconds = Math.floor((now - date) / 1000);
    const minutes = Math.floor(seconds / 60);
    const hours = Math.floor(minutes / 60);
    const days = Math.floor(hours / 24);
    const months = Math.floor(days / 30);
    const years = Math.floor(days / 365);

    if (seconds < 60) return 'только что';
    if (minutes < 60) return `${minutes} минут назад`;
    if (hours < 24) return `${hours} час${hours === 1 ? '' : 'ов'} назад`;
    if (days < 30) return `${days} дн${days === 1 ? 'ь' : 'ей'} назад`;
    if (months < 12) return `${months} месяц${months === 1 ? '' : 'ев'} назад`;
    return `${years} год${years === 1 ? '' : 'а'} назад`;
  }

  async function upListing(listingId) {
    if (!listingId) {
      Swal.fire('Ошибка', 'Не указан ID объявления', 'error');
      return;
    }

    const token = localStorage.getItem('jwt') || sessionStorage.getItem('jwt');

    // Отправляем запрос на поднятие объявления
    try {
      const res = await fetch(`/market/listings/${listingId}/up`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        }
      });

      const data = await res.json();

      if (!res.ok) {
        Swal.fire('⏳ Подождите', data.message || 'Ошибка при поднятии', 'warning');
        return;
      }

      // Успех — обновляем время и показываем сообщение
      // const now = new Date(data.up_date);
      // const upDateElement = document.getElementById('up-date-placeholder');
      // upDateElement.dataset.upDate = now.toISOString();
      // upDateElement.textContent = `UP: ${timeAgo(now)}`;

      // Обновляем дату "UP" в DOM
      const upEl = document.getElementById('up-date-placeholder');
      const newDate = new Date(data.up_date);
      upEl.dataset.upDate = data.up_date;
      upEl.textContent = `UP: ${timeAgo(newDate)}`;


      console.log('🔼 Поднимаем объявление:', listingId);


      Swal.fire('✅ Успешно', 'Объявление поднято', 'success');

      // (опционально) Перезагрузка страницы, если список нужно обновить
      // location.reload();

    } catch (err) {
      console.error(err);
      Swal.fire('Ошибка', 'Не удалось выполнить запрос', 'error');
  }
}

 
  document.addEventListener('DOMContentLoaded', () => {
    const upDateElement = document.getElementById('up-date-placeholder');
    const upDate = upDateElement.dataset.upDate;

    function updateUpText() {
      if (upDate) {
        upDateElement.textContent = `UP: ${timeAgo(new Date(upDate))}`;
      } else {
        upDateElement.textContent = 'UP: Никогда';
      }
    }

    updateUpText();
    setInterval(updateUpText, 60000);
  });
</script>
