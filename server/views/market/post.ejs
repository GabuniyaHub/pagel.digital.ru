<%- include('../partials/header') %>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="stylesheet" href="/market/assets/post/post.css">
<link rel="stylesheet" href="/market/assets/post/modal.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<link rel="stylesheet" href="/market/assets/post/modalForm.css">
<title>
  <%= listing.name || 'Объявление' %>
</title>

<% if (listing.form_type === 1) { %>
  <section class="post"
    id="post-section-1"
    data-listing="<%= listing.id %>">
    <div class="post-header">
      <div class="post-header-back-link-container">
        <a href="javascript:history.back()" class="back-link">Назад к листингам</a>
      </div>
      <div class="post-header-info-container">
        <div class="header-left-container">
          <p id="created-at-placeholder" data-form-type=" <%= listing.form_type %> " data-created-at="<%= listing.created_at %>">Создано: <%= listing.created_at ?
              listing.created_at.toLocaleString() : '' %>
          </p>
          <p id="up-date-placeholder" data-up-date="<%= listing.up_date %>">
            UP: 
          </p>
          <p id="count-views" data-listing="<%= listing.id %>">Просмотров: <span id="views-count">
              <%= listing.views || 0 %>
            </span></p>
        </div>
        <div class="header-right-container">
          <a onclick="openReportModal()">Сообщить о нарушении</a>
        </div>
        <div id="reportModal" class="modal-report" style="display: none;">
          <div class="modal-content-report">
            <span class="close-report" onclick="closeModal()">&times;</span>
            <h3>Куда отправить жалобу?</h3>

            <div class="report-option" onclick="sendViaEmail()">
              <img src="https://detstomat-stoskol.belzdrav.ru/upload/medialibrary/771/email.jpg" alt="Email"> Написать
              на почту
            </div>

            <div class="report-option" onclick="sendViaTelegram()">
              <img src="https://gazetteller.com/wp-content/uploads/2023/05/telegram-svgrepo-com.svg" alt="Telegram">
              Написать в Telegram
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="post-body">
      <div class="body-header">
        <div class="body-header-user">
          <div class="body-header-user-name">
            <a  href="/account/public/<%= listing.user_id %>" style="text-decoration: none; color: inherit;">
              <img id="avatar-placeholder" src="/market/assets/item/i.webp" alt="Аватар пользователя"
              class="body-header-user-avatar" style="display: none;">
              <div class="body-header-user-name-container" id="user-info-container"
              data-user-id="<%= listing.user_id %>">
              <h1 id="username-placeholder">Пользователь #<%= listing.user_id %>
              </h1>
              <p>Рейтинг продавца:
                <span id="positive-count"></span>
                <span class="dot dot-green"></span>
                <span id="neutral-count"></span>
                <span class="dot dot-grey"></span>
                <span id="negative-count"></span>
                <span class="dot dot-red"></span>
              </p>
            </a>
            </div>
          </div>
          <!-- <div class="body-header-user-reviews">
            <p>Положительные отзывы: —</p>
            <p>Нейтральные отзывы: —</p>
            <p>Отрицательные отзывы: —</p>
          </div> -->
          <div class="body-header-user-contact-seller">
            <button class="body-header-user-contact-seller-button" onclick="openContactModal()">Связаться с
              продавцом</button>
          </div>

          <!-- Модальное окно для контактов -->
          <div id="contactModal" class="modal-contact" style="display: none;">
            <div class="modal-content-contact">
              <span class="close" onclick="closeModalContact()">&times;</span>
              <h3>Связь с продавцом <%= user.name %>
              </h3>

              <% if (user.contacts.telegram) { %>
                <div class="contact-option" onclick="openLink('https://t.me/<%= user.contacts.telegram %>')">
                  <img src="https://cdn-icons-png.flaticon.com/512/2111/2111646.png" alt="Telegram"> Telegram
                </div>
                <% } %>

              <% if (user.contacts.vk) { %>
                <div class="contact-option" onclick="openLink('<%= user.contacts.vk %>')">
                  <img src="https://cdn-icons-png.flaticon.com/512/145/145813.png" alt="VK"> ВКонтакте
                </div>
                <% } %>

              <% if (user.contacts.instagram) { %>
                <div class="contact-option"
                  onclick="openLink('https://instagram.com/<%= user.contacts.instagram %>')">
                  <img src="https://cdn-icons-png.flaticon.com/512/174/174855.png" alt="Instagram"> Instagram
                </div>
                <% } %>

                <% if (user.contacts.email) { %>
                  <div class="contact-option" onclick="openLink('mailto:<%= user.contacts.email %>')">
                    <img src="https://avatars.mds.yandex.net/i?id=e2f89817dbeeb56a92fc07530fc1269b_sr-5552396-images-thumbs&n=13"
                      alt="Email"> Email
                  </div>
                <% } %>

                <% if (user.contacts.whatsapp) { %>
                  <div class="contact-option"
                    onclick="openLink('https://whatsapp.com/<%= user.contacts.whatsapp %>')">
                    <img src="https://cdn-icons-png.flaticon.com/512/220/220236.png" alt="whatsapp">
                    WhatsApp
                  </div>
                <% } %>
            </div>
          </div>
        </div>
        <div class="body-header-briefly-post">
          <div class="body-header-briefly-post-left">
            <img id="listing-avatar"
              src="<%= listing.cover ? '/market/uploads/' + listing.cover : '/market/assets/item/poster-way-mountain-forest-landscape-summer-illustration-vector.jpg' %>"
              class="body-header-briefly-post-image" alt="Изображение поста" data-link="<%= listing.link %>"
              data-platform="<%= listing.platform_slug %>">
            <div class="body-header-briefly-post-NTL">
              <h1 id="listing-title" data-listingName="listing.name"><%= listing.name || 'Название поста' %></h1>
              <% if (listing.theme) { %>
                <!-- <p>Тема: <%= listing.theme %></p> -->
                <p id="theme-text" data-listingTheme="listing.theme">Тема: <span id="theme-value"><%= listing.theme %></span></p>
              <% } %>

              <% if (listing.show_link) { %>
                <p>Ссылка: <a href="<%= listing.link %>" target="_blank"><%= listing.link %></a></p>
              <% } else if (listing.link) { %>
                  <p>Ссылка: <b style="font-size: medium; color: #7a7a7a; font-weight: 300;">скрыта автором объявления</b></p>
              <% } %>


              <% if (currentUser && listing.user && currentUser.id===listing.user.id) { %>
                <div class="listing-actions">
                  <button 
                      id="editListing"
                      class="btn btn-edit"
                      data-id="<%= listing.id %>"
                      data-form-type="<%= listing.form_type %>"
                      data-description="<%- listing.description.replace(/"/g, '&quot;') %>"
                      data-price="<%= listing.price %>"
                      data-category="<%= listing.category_id %>"
                    >
                      Редактировать
                  </button>

                  <div id="formType1Modal" style="display:none;" class="modal"> 
                      <div class="modal-content">
                        <span class="close-button" id="closeForm1Modal" style="position: absolute; top: 10px; right: 10px; cursor: pointer; font-size: 24px;">&times;</span> 
                        <section class="form"> 
                          <input type="hidden" id="listing_id_hidden_field" name="id">
                          <div class="create-listing">
                              <form id="listing-form" class="listing-form" enctype="multipart/form-data" method="POST">
                                  <div class="header-form-listing">
                                      <div class="form-row">
                                        <input type="url" id="link" name="link"
                                          placeholder="Вставьте ссылку на аккаунт/канал/группу/страницу, выставляемую на продажу"
                                          required pattern="https?://.+"
                                          title="Введите корректную ссылку, начинающуюся с http:// или https://"
                                          disabled>
                                        <label class="form-checkbox">
                                            <input type="checkbox" id="show_link" name="show_link"> <span>Показать ссылку</span>
                                        </label>
                                      </div>
                                      <div class="form-row">
                                        <select id="theme" name="groupTheme" required>
                                            <option value="" disabled selected hidden>Выберите тематику...</option>
                                            <option value="1">Авто</option>
                                            <option value="2">Бизнес</option>
                                            <option value="3">Дизайн</option>
                                            <option value="4">Животные</option>
                                            <option value="5">ЖЦА 30+</option>
                                            <option value="6">Здоровье</option>
                                            <option value="7">Знакомство и общение</option>
                                            <option value="8">Игры</option>
                                            <option value="9">IT</option>
                                            <option value="10">Культура</option>
                                            <option value="11">Кино</option>
                                            <option value="12">Кулинария</option>
                                            <option value="13">Литература</option>
                                            <option value="14">Мода и красота</option>
                                            <option value="15">Молодежные до 18</option>
                                            <option value="16">МЦА 30+</option>
                                            <option value="17">Наука и факты</option>
                                            <option value="18">Недвижимость</option>
                                            <option value="19">Новости и сми</option>
                                            <option value="20">Образование</option>
                                            <option value="21">Объявления</option>
                                            <option value="22">Политика</option>
                                            <option value="23">Природа</option>
                                            <option value="24">Психология</option>
                                            <option value="25">Развлечения</option>
                                            <option value="26">Регион. порталы</option>
                                            <option value="27">Религия</option>
                                            <option value="28">Ремонт</option>
                                            <option value="29">Работа</option>
                                            <option value="30">Семья</option>
                                            <option value="31">Спорт</option>
                                            <option value="32">Товары и услуги</option>
                                            <option value="33">Туризм</option>
                                            <option value="34">Фото</option>
                                            <option value="35">Хобби</option>
                                            <option value="36">Эзотерика</option>
                                            <option value="37">Эротика</option>
                                            <option value="38">Юмор</option>
                                            <option value="39">Другое</option>
                                            <option value="40">Фан группы</option>
                                            <option value="41">Крипта/NFT</option>
                                        </select>
                                    </div>
                                      <div class="form-row">
                                          <input type="number" id="price" name="price" placeholder="Введите цену ($)" min="0"
                                              step="0.01" required title="Введите только число, например: 100 или 99.99">
                                          <label class="form-checkbox">
                                              <input type="checkbox" id="allow_comments" name="allow_comments"> <span>Разрешить комментарии</span>
                                          </label>
                                      </div>
                                  </div>
                                  <div class="body-form-listing">
                                      <label for="description">Описание:</label>
                                      <textarea id="description" name="description" placeholder="Введите описание" required
                                          pattern=".{10,500}" title="Описание должно содержать от 10 до 500 символов"
                                          maxlength="500"></textarea>

                                      <div class="content-type-block">
                                          <span class="content-type-label">Укажите основной контент в группе:</span>
                                          <div class="content-type-options">
                                              <label><input type="radio" name="content_type" value="unique" required>Уникальный контент</label>
                                              <label><input type="radio" name="content_type" value="rewrite">Переписанный (рерайт) контент</label>
                                              <label><input type="radio" name="content_type" value="copy">Не уникальный контент (копия)</label>
                                              <label><input type="radio" name="content_type" value="mixed">Смешанный контент</label>
                                          </div>
                                      </div>

                                      <div class="income-expense-row">
                                          <input type="number" id="income" name="income" placeholder="Доход ($/мес)" min="0"
                                              step="0.01">
                                          <input type="number" id="expense" name="expense" placeholder="Расход ($/мес)" min="0"
                                              step="0.01">
                                      </div>

                                      <div class="monetization-block">
                                          <span class="monetization-label">Монетизация:</span>
                                          <div class="monetization-options">
                                              <label>
                                                  <input type="radio" name="monetization" value="1" required> Включена
                                              </label>
                                              <label>
                                                  <input type="radio" name="monetization" value="0"> Выключена
                                              </label>
                                          </div>
                                      </div>

                                      <label for="income_sources">Источники дохода:</label>
                                      <textarea id="income_sources" name="income_sources" placeholder="Опишите источники дохода"
                                          required pattern=".{5,500}" title="Минимум 5 символов" maxlength="500"></textarea>

                                      <label for="expense_sources">Источники расхода:</label>
                                      <textarea id="expense_sources" name="expense_sources" placeholder="Опишите источники расхода"
                                          required pattern=".{5,500}" title="Минимум 5 символов" maxlength="500"></textarea>

                                      <label for="promotion">Продвижение:</label>
                                      <textarea id="promotion" name="promotion" placeholder="Опишите продвижение" required
                                          pattern=".{5,500}" title="Минимум 5 символов" maxlength="500"></textarea>

                                      <label for="support_needs">Потребности в поддержке:</label>
                                      <textarea id="support_needs" name="support_needs" placeholder="Что необходимо для поддержания?"
                                          required pattern=".{5,500}" title="Минимум 5 символов" maxlength="500"></textarea>

                                      <div class="file-upload-block">
                                          <label for="screenshots" class="file-upload-label">
                                              <b>Прикрепить скриншоты (подтверждения доходов и т.д.):</b>
                                          </label>
                                          <div id="drop-area" class="drop-area">
                                              <span id="drop-area-text">Перетащите сюда изображения</span>
                                              <input type="file" id="screenshots" name="screenshots" multiple accept="image/*"
                                                  class="file-upload-input" style="display:none;">
                                              <div id="preview-list" class="preview-list"></div>
                                          </div>
                                      </div>

                                  </div>

                                  <div class="footer-form-listing">

                                      <div class="contacts-section">
                                          <h3>Контактные данные</h3>
                                          <p style="color: #888888; font-size: medium;">
                                              Введите минимум 1 поле
                                          </p>
                                          <input type="text" name="contacts[telegram]" placeholder="Telegram, например: @username"
                                              class="contact-input" maxlength="32">

                                          <input type="text" name="contacts[vk]" placeholder="VK, например: https://vk.com/id123"
                                              class="contact-input" maxlength="100">

                                          <input type="text" name="contacts[instagram]" placeholder="Instagram, например: @my.profile"
                                              class="contact-input" maxlength="30">

                                          <input type="text" name="contacts[whatsapp]"
                                              placeholder="WhatsApp, например: +7 900 123-45-67" class="contact-input" maxlength="20">

                                          <input type="text" name="contacts[email]" placeholder="E-mail, например: example@mail.ru"
                                              class="contact-input" maxlength="100">
                                      </div>

                                      <button type="submit" id="submit-button">
                                          <i class="fas fa-paper-plane"></i> Сохранить изменения 
                                      </button>
                                  </div>
                              </form>
                          </div>
                        </section>
                    </div>
                  </div>
                  <button onclick="upListing(<%= listing.id %>)" class="btn btn-up">UP</button>
                  <button onclick="deleteListing(<%= listing.id %>)" class="btn btn-delete">Удалить</button>
                </div>
              <% } %>
                <!-- <p>Ссылка: example.com</p> -->
                <!-- <button class="body-header-briefly-post-button">Купить</button> -->
              </div>
          </div>
          <div class="body-header-briefly-post-SIE">
            <p id="listing-subscribers">Подписчиков: <%= listing.subscribers %></p>
            <% if (listing.income) { %>
              <p>Доход (месяц): $<%= listing.income %></p>
              <% } %>
            <% if (listing.expense) { %>
              <p>Расход (месяц): $<%= listing.expense %></p>
            <% } %>
            <div class="body-header-briefly-post-price">
              <p>Цена: <b>$<%= listing.price %></b></p>
            </div>
            <div class="body-header-briefly-post-buttons">
              <!-- <button class="body-header-briefly-post-button">Купить</button> -->
              <button class="body-header-briefly-post-button favorite-btn"
                onclick="toggleFavorite('<%= listing.id %>')" data-listing-id="<%= listing.id %>">
                <i class="<%= listing.is_favorite ? 'fas' : 'far' %> fa-heart"></i>
                <%= listing.is_favorite ? 'В избранном' : 'Добавить в избранное' %>
              </button>
            </div>
          </div>
        </div>
      </div>
      <div class="body-content">
        <div class="body-content-info">
            <p><b>Описание:</b><%= listing.description %></p>
            <% if (listing.content_type) { %>
            <!-- <p><b>Основной контент:</b> <%= listing.content_type %></p> -->
            <p><b>Основной контент:</b> <span id="content-type"><%= listing.content_type %></span></p>
            <% } %>
            <% if (typeof listing.monetization !=='undefined' ) { %>
              <p><b>Монетизация:</b>
                <%= listing.monetization ? 'Включена' : 'Отключена' %>
              </p>
            <% } %>
            <% if (listing.income_sources) { %>
              <p><b>Источники дохода:</b>
                <%= listing.income_sources %>
              </p>
            <% } %>
            <% if (listing.expense_sources) { %>
              <p><b>Источники расхода:</b>
                <%= listing.expense_sources %>
              </p>
            <% } %>
            <% if (listing.promotion) { %>
              <p><b>Продвижение:</b><%= listing.promotion %></p>
            <% } %>
            <% if (listing.support_needs) { %>
              <p><b>Потребности в поддержке:</b><%= listing.support_needs %></p>
            <% } %>
        </div>
        <div class="body-content-screenshots">
          <p><b>Прикрепленные скриншоты:</b></p>
          <div class="body-content-screenshots-custom">
            <% if (listing.screenshots && Array.isArray(listing.screenshots) && listing.screenshots.length> 0) { %>
              <% listing.screenshots.forEach(function(screenshot) { %>
                <img src="/market/uploads/<%= screenshot %>" alt="Скриншот" class="screenshot-image"
                  data-image-url="/market/uploads/<%= screenshot %>">
            <% }) %>
            <% } else { %>
                  <!-- <div class="screenshot-placeholder"></div> -->
                  <p style="margin-top: 10px">Cкриншоты отсутствуют</p>
              <% } %>
          </div>
        </div>

        <!-- Модальное окно -->
        <div id="screenshotModal" class="modal">
          <span class="close">&times;</span> <!-- Кнопка закрытия перемещена сюда -->
          <div class="modal-contenT">
            <img id="modalImage" src="" alt="Большой скриншот">
          </div>
        </div>

      </div>
    </div>
    <div class="post-footer">
      <% if (!listing.allow_comments) { %>
        <div class="post-footer-head">
          <h3>Комментарии</h3>
          <span>Автор отключил комментарии к этому объявлению</span>
        </div>
      <% } else { %>
        <div class="post-footer-head">
          <h3>Комментарии</h3>
          <% if (!comments || comments.length===0) { %>
            <span>Никто не писал комментарии, станьте первым.</span>
          <% } %>
        </div>

        <div class="post-footer-write-block">
          <textarea id="comment-text" placeholder="Написать комментарий"></textarea>
        </div>

        <div class="post-footer-buttons">
          <button id="send-comment">Отправить сообщение</button>
        </div>

        <div class="post-footer-comments-block">
          <% if (comments && comments.length> 0) { %>
            <% comments.slice().reverse().forEach(comment=> { %>
              <div class="comment <%= currentUser && comment.user_id === currentUser.id ? 'my-comment' : '' %>">
                <% if (comment.author_avatar) { %>
                  <img src="<%= comment.author_avatar %>" alt="аватар" class="avatar">
                  <% } %>
                    <div class="comment-content">
                      <strong>
                        <%= comment.author_name %>:
                      </strong>
                      <%= comment.message %>
                        <div class="comment-time">
                          <%= new Date(comment.created_at).toLocaleString('ru-RU', { day: '2-digit' ,
                            month: '2-digit' , year: 'numeric' , hour: '2-digit' , minute: '2-digit' }) %>
                        </div>
                    </div>
              </div>
              <% }) %>
            <% } %>
        </div>
      <% } %>
    </div>
  </section>
<% } else { %>
  <section class="post"
    id="post-section-2"
    data-listing="<%= listing.id %>" >
    <div class="post-header">
      <div class="post-header-back-link-container">
        <a href="javascript:history.back()" class="back-link">Назад к листингам</a>
      </div>
      <div class="post-header-info-container">
        <div class="header-left-container">
          <p id="created-at-placeholder" data-created-at="<%= listing.created_at %>">Создано: <%= listing.created_at
              ? listing.created_at.toLocaleString() : '' %>
          </p>
          <p id="up-date-placeholder" data-up-date="<%= listing.up_date %>">UP:
          </p>
          <p data-listing="<%= listing.id %>">Просмотров: <span id="views-count">
              <%= listing.views || 0 %>
            </span></p>
        </div>
        <div class="header-right-container">
          <a onclick="openReportModal()">Сообщить о нарушении</a>
        </div>
        <div id="reportModal" class="modal-report" style="display: none;">
          <div class="modal-content-report">
            <span class="close-report" onclick="closeModal()">&times;</span>
            <h3>Куда отправить жалобу?</h3>

            <div class="report-option" onclick="sendViaEmail()">
              <img src="https://detstomat-stoskol.belzdrav.ru/upload/medialibrary/771/email.jpg" alt="Email">
              Написать на почту
            </div>

            <div class="report-option" onclick="sendViaTelegram()">
              <img src="https://gazetteller.com/wp-content/uploads/2023/05/telegram-svgrepo-com.svg" alt="Telegram">
              Написать в Telegram
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="post-body">
      <div class="body-header">
        <div class="body-header-user">
          <div class="body-header-user-name">
            <img id="avatar-placeholder" src="/market/assets/item/i.webp" alt="Аватар пользователя"
              class="body-header-user-avatar">
            <div class="body-header-user-name-container" id="user-info-container"
              data-user-id="<%= listing.user_id %>">
              <h1 id="username-placeholder">Пользователь #<%= listing.user_id %>
              </h1>
              <p>Рейтинг продавца:
                <span id="positive-count"></span>
                <span class="dot dot-green"></span>
                <span id="neutral-count"></span>
