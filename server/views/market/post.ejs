<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= listing.name || 'Объявление' %> — PL-GL</title>
  <script src="/scripts/common/app.js?v=5"></script>
  <link rel="icon" type="image/svg+xml" href="/assets/images/pl-gl-logo.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="48x48" href="/assets/images/favicon-48x48.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/favicon-180x180.png">
  <link rel="icon" href="/assets/images/favicon.ico">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Sofia+Sans+Extra+Condensed:wght@600;700&display=swap">
  <link rel="stylesheet" href="/market/assets/item/catalog-plgl.css?v=2">
  <link rel="stylesheet" href="/market/assets/post/post-plgl.css?v=1">
  <script src="/scripts/common/media.js?v=1" defer></script>
  <script src="/scripts/common/market-shell.js?v=1" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11" defer></script>
</head>
<body class="listing-page">
<%
const owner = currentUser && String(currentUser.id) === String(listing.user_id);
const fallback = '/assets/images/youtube-catalog/' + (channel ? '02-youtube-channel-sell' : '08-youtube-services') + '.png';
const cover = media.coverUrl(listing.cover, fallback);
const screenshots = Array.isArray(listing.screenshots) ? listing.screenshots : [];
const contentLabels = { unique:'Уникальный', rewrite:'Рерайт', copy:'Копии', mixed:'Смешанный' };
%>
<%- include('../partials/plgl-header') %>
<main class="listing-shell" id="listing-page" data-listing-id="<%= listing.id %>" data-seller-id="<%= listing.user_id %>" data-catalog-path="<%= catalogPath %>">
  <nav class="catalog-breadcrumbs" aria-label="Хлебные крошки"><a href="/pages/index.html">Каталог</a><span>/</span><a href="<%= catalogPath %>"><%= category.description %></a><span>/</span><span>Объявление № <%= listing.id %></span></nav>
  <div class="listing-topline"><a class="text-button" href="<%= catalogPath %>">← Все предложения в категории</a><div><button class="text-button" id="share-listing" type="button">↗ Поделиться</button><button class="text-button" type="button" data-dialog="report-dialog">Сообщить о нарушении</button></div></div>
  <div class="listing-layout">
    <div class="listing-main">
      <section class="listing-card listing-intro">
        <p class="catalog-eyebrow"><span class="youtube-mini" aria-hidden="true">▶</span> YOUTUBE <span> / </span><%= channel ? 'ПРОДАЖА КАНАЛА' : category.description %></p>
        <div class="listing-title-row">
          <% if (channel) { %><img class="channel-avatar" src="<%= cover %>" data-channel-id="<%= listing.id %>" data-fallback="<%= media.fallbackAvatar %>" alt="Аватар канала"><% } %>
          <div><h1><%= listing.name || 'Объявление YouTube' %></h1><p class="listing-meta"><span>№ <%= listing.id %></span><span>Опубликовано <time><%= date(listing.created_at) %></time></span><span><span id="listing-views"><%= number(listing.views) %></span> просмотров</span></p></div>
        </div>
        <% if (channel) { %>
          <div class="channel-facts"><div><span>Подписчики</span><strong data-subscribers-id="<%= listing.id %>"><%= number(listing.subscribers) %></strong></div><div><span>Тематика</span><strong><%= theme %></strong></div><div><span>Монетизация</span><strong><%= listing.monetization ? 'Включена' : 'Отключена' %></strong></div></div>
          <p class="channel-link"><% if (listing.show_link && /^https:\/\/(www\.)?youtube\.com\//i.test(listing.link || '')) { %><a href="<%= listing.link %>" target="_blank" rel="noopener noreferrer">Открыть канал на YouTube ↗</a><% } else { %>Ссылка на канал скрыта продавцом. Уточните подробности перед покупкой.<% } %></p>
        <% } else { %>
          <button class="service-cover gallery-trigger" type="button" data-image="<%= cover %>" aria-label="Увеличить обложку"><img src="<%= cover %>" data-fallback="<%= fallback %>" alt="<%= listing.name %>"><span>Открыть изображение ↗</span></button>
        <% } %>
        <nav class="listing-sections" aria-label="Разделы объявления"><a href="#description">Описание</a><% if (screenshots.length) { %><a href="#gallery"><%= channel ? 'Статистика' : 'Примеры работ' %></a><% } %><a href="#comments">Обсуждение <span id="comment-tab-count"><%= comments.length %></span></a></nav>
      </section>
      <section class="listing-card" id="description"><p class="section-kicker"><%= channel ? 'О КАНАЛЕ' : 'ОБ УСЛУГЕ' %></p><h2><%= channel ? 'Описание и особенности' : 'Что предлагает исполнитель' %></h2><div class="listing-description"><%= listing.description %></div>
        <% if (channel) { %>
          <dl class="listing-finance"><div><dt>Доход / месяц</dt><dd><%= listing.income != null ? number(listing.income) + ' $' : 'Не указан' %></dd></div><div><dt>Расход / месяц</dt><dd><%= listing.expense != null ? number(listing.expense) + ' $' : 'Не указан' %></dd></div><div><dt>Тип контента</dt><dd><%= contentLabels[listing.content_type] || 'Не указан' %></dd></div></dl>
          <% [['income_sources','Источники дохода'],['expense_sources','Источники расходов'],['promotion','Продвижение'],['support_needs','Поддержка канала']].forEach(([key,label]) => { if (listing[key]) { %><div class="listing-detail"><h3><%= label %></h3><p><%= listing[key] %></p></div><% } }); %>
          <p class="detail-note">Финансовые показатели указаны продавцом. Запросите подтверждения перед покупкой.</p>
        <% } %>
      </section>
      <% if (screenshots.length) { %><section class="listing-card" id="gallery"><p class="section-kicker"><%= channel ? 'ДАННЫЕ ПРОДАВЦА' : 'ПОРТФОЛИО' %></p><h2><%= channel ? 'Скриншоты и статистика' : 'Примеры работ' %></h2><div class="listing-gallery"><% screenshots.forEach((file,index) => { %><button type="button" class="gallery-trigger" data-image="<%= media.coverUrl(file) %>" aria-label="Открыть изображение <%= index + 1 %>"><img src="<%= media.coverUrl(file) %>" alt="<%= channel ? 'Статистика канала' : 'Пример работы' %> <%= index + 1 %>" loading="lazy"><span><%= index + 1 %> / <%= screenshots.length %></span></button><% }); %></div></section><% } %>
      <section class="listing-card discussion" id="comments"><div class="discussion-heading"><div><p class="section-kicker">ВОПРОСЫ И ОТВЕТЫ</p><h2>Обсуждение <span id="comment-count"><%= comments.length %></span></h2></div><span>По существу и с уважением</span></div>
        <% if (listing.allow_comments) { %>
          <form id="comment-form"><div class="comment-compose"><img id="comment-viewer-avatar" src="<%= media.fallbackAvatar %>" alt="" class="comment-avatar"><div><div id="reply-banner" hidden><span></span><button type="button" id="cancel-reply" class="text-button">Отменить ответ</button></div><label for="comment-text" class="sr-only">Ваш комментарий</label><textarea id="comment-text" name="message" rows="3" maxlength="500" placeholder="<%= channel ? 'Спросите о статистике, доходе или передаче канала…' : 'Уточните сроки, результат или условия работы…' %>" required></textarea><div class="comment-compose-footer"><span><span id="comment-length">0</span> / 500</span><button type="submit" class="pl-button">Отправить комментарий →</button></div><p id="comment-error" class="inline-error" role="alert" hidden></p></div></div></form>
        <% } else { %><p class="detail-note">Автор отключил новые комментарии к этому объявлению.</p><% } %>
        <p id="comments-empty" class="comments-empty" <%= comments.length ? 'hidden' : '' %>>Пока нет комментариев.<%= listing.allow_comments ? ' Задайте первый вопрос автору.' : '' %></p>
        <div id="comments-list"><% threads.forEach(thread => { %><div class="comment-thread" data-thread-id="<%= thread.id %>"><%- include('partials/comment', {comment:thread}) %><div class="comment-replies"><% thread.replies.forEach(reply => { %><%- include('partials/comment', {comment:reply}) %><% }); %></div></div><% }); %></div>
      </section>
    </div>
    <aside class="listing-sidebar">
      <section class="listing-card purchase-card"><p class="section-kicker"><%= channel ? 'СТОИМОСТЬ КАНАЛА' : 'СТОИМОСТЬ УСЛУГИ' %></p><div class="listing-price"><%= number(listing.price) %> <span>$</span></div><p class="purchase-note"><%= channel ? 'Обсудите условия и порядок передачи с продавцом.' : 'Согласуйте объём работы и сроки с исполнителем.' %></p><button class="pl-button contact-button" type="button" data-dialog="contact-dialog">Связаться с <%= channel ? 'продавцом' : 'исполнителем' %> ↗</button><button class="pl-button pl-button-light" id="favorite-toggle" type="button" aria-pressed="<%= listing.isFavorite ? 'true' : 'false' %>"><%= listing.isFavorite ? '♥ В избранном' : '♡ Добавить в избранное' %></button>
        <div class="seller-card"><a href="/account/public/<%= listing.user_id %>" class="seller-identity"><img src="<%= media.avatarUrl(listing.user?.avatar) %>" data-fallback="<%= media.fallbackAvatar %>" alt=""><span><small><%= channel ? 'Продавец' : 'Исполнитель' %></small><strong><%= listing.user?.username || 'Пользователь' %></strong><% if (listing.seller_verified) { %><small>✓ Профиль подтверждён</small><% } %></span><span aria-hidden="true">↗</span></a><div class="seller-reviews" id="seller-reviews"><span>Отзывы продавца</span><strong>Загружаем…</strong></div><a href="/account/public/<%= listing.user_id %>" class="text-button">Посмотреть профиль и отзывы →</a></div>
      </section>
      <div class="listing-safety"><span aria-hidden="true">◇</span><h3><%= channel ? 'Проверьте перед покупкой' : 'Договоритесь о деталях' %></h3><p><%= channel ? 'Запросите актуальную статистику, проверьте ограничения и права на контент. Согласуйте каждый шаг передачи канала.' : 'Опишите задачу, ожидаемый результат, сроки и количество правок. Сохраните договорённости до начала работы.' %></p></div>
      <% if (owner) { %><section class="listing-card owner-actions"><h2>Управление объявлением</h2><button type="button" class="pl-button pl-button-light" data-dialog="edit-dialog">Редактировать</button><button type="button" class="pl-button pl-button-light" id="raise-listing">Поднять в каталоге ↑</button><p id="raised-at"><%= listing.up_date ? 'Поднято: ' + date(listing.up_date) : 'Объявление ещё не поднималось' %></p><button type="button" class="text-button danger-button" data-dialog="delete-dialog">Удалить объявление</button></section><% } %>
    </aside>
  </div>
</main>
<dialog id="contact-dialog" class="listing-dialog" aria-labelledby="contact-title"><div class="dialog-heading"><div><p class="catalog-eyebrow">ПРЯМАЯ СВЯЗЬ</p><h2 id="contact-title"><%= listing.user?.username || 'Контакты автора' %></h2></div><button type="button" data-close class="dialog-close" aria-label="Закрыть">×</button></div><p>Уточните условия объявления № <%= listing.id %> удобным способом.</p><div class="contact-options"><% contacts.forEach(contact => { %><a href="<%= contact.href %>" target="_blank" rel="noopener noreferrer"><span><strong><%= contact.label %></strong><small><%= contact.value %></small></span><span>↗</span></a><% }); %></div><% if (!contacts.length) { %><p>Автор пока не указал контакты. Задайте вопрос в обсуждении или посмотрите его профиль.</p><a class="pl-button" href="/account/public/<%= listing.user_id %>">Профиль автора</a><% } %></dialog>
<dialog id="report-dialog" class="listing-dialog" aria-labelledby="report-title"><div class="dialog-heading"><h2 id="report-title">Сообщить о нарушении</h2><button type="button" data-close class="dialog-close" aria-label="Закрыть">×</button></div><p>Укажите номер объявления <strong>№ <%= listing.id %></strong>, опишите нарушение и приложите подтверждения в обращении.</p><a class="pl-button" href="mailto:support@pl-gl.ru?subject=<%= encodeURIComponent('Жалоба на объявление № ' + listing.id) %>">Написать в поддержку</a><a class="text-button" href="/pages/lending/contacts.html">Другие способы связи →</a></dialog>
<dialog id="gallery-dialog" class="listing-dialog gallery-dialog" aria-label="Просмотр изображения"><button type="button" data-close class="dialog-close" aria-label="Закрыть">×</button><img id="gallery-image" alt="Изображение объявления"><div class="gallery-controls"><button class="pl-button pl-button-light" type="button" id="gallery-prev" aria-label="Предыдущее изображение">←</button><span id="gallery-counter"></span><button class="pl-button pl-button-light" type="button" id="gallery-next" aria-label="Следующее изображение">→</button></div></dialog>
<% if (owner) { %><%- include('partials/post-editor') %><dialog id="delete-dialog" class="listing-dialog" aria-labelledby="delete-title"><div class="dialog-heading"><h2 id="delete-title">Удалить объявление?</h2><button type="button" data-close class="dialog-close" aria-label="Закрыть">×</button></div><p>Объявление и обсуждение будут удалены. Восстановить их будет нельзя.</p><div class="dialog-actions"><button type="button" class="pl-button pl-button-light" data-close>Отмена</button><button type="button" class="pl-button" id="delete-listing">Удалить</button></div><p id="delete-error" class="inline-error" role="alert" hidden></p></dialog><% } %>
<%- include('../partials/plgl-footer') %>
<script src="/market/scripts/post/post-plgl.js?v=1" defer></script>
<script type="module" src="/scripts/favoritesModal/favoritesMain.js?v=media-4"></script>
<script type="module" src="/scripts/settingsModal/main.js?v=security-2"></script>
</body>
</html>
