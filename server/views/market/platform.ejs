<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="stylesheet" href="../market/assets/styles.css">
<title><%= platform.name %></title>
<%- include('../partials/header') %>


<section class="platform">
  <div class="platform-header">
    <img src="<%= platform.icon %>" alt="<%= platform.name %>">
    <div class="platform-info">
      <h1><%= platform.name %></h1>
      <p><%= platform.description %></p>
    </div>
  </div>
</section>

<section class="products">
  <h2>Услуги</h2>
  <div class="products-list">
    <% if (platform.products && platform.products.length > 0) { %>
      <% platform.products.forEach(product => { %>
        <a href="/market/<%= platform.id %>/<%= product.name %>/items" style="color: inherit; text-decoration: none;">
          <div class="product-card">
            <div class="card-header">
              <img src="<%= platform.icon %>" alt="<%= product.name %>">
              <h3><%= product.name %></h3>
            </div>
            <p><%= product.description %></p>
            <!-- <p>Цена: $<%= product.price %></p> -->
            <!-- <button>Перейти</button> -->
          </div>
        </a>

      <% }) %>
    <% } else { %>
      <p>Услуги отсутствуют.</p>
    <% } %>
  </div>
</section>

