<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> — каталог PL-GL</title>
  <script src="/scripts/common/app.js?v=5"></script>
  <link rel="icon" type="image/svg+xml" href="/assets/images/pl-gl-logo.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="48x48" href="/assets/images/favicon-48x48.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/favicon-180x180.png">
  <link rel="icon" href="/assets/images/favicon.ico">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Sofia+Sans+Extra+Condensed:wght@600;700&display=swap">
  <link rel="stylesheet" href="/market/assets/item/catalog-plgl.css?v=2">
  <script src="/scripts/common/media.js?v=1" defer></script>
  <script src="/scripts/common/market-shell.js?v=1" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11" defer></script>
</head>
<body class="catalog-page">
<%- include('../partials/plgl-header') %>
<main class="catalog-shell">
  <nav class="catalog-breadcrumbs" aria-label="Хлебные крошки"><a href="/pages/index.html">Каталог</a><span aria-hidden="true">/</span><span><%= title %></span></nav>
  <section class="catalog-heading">
    <div><p class="catalog-eyebrow"><span class="youtube-mini" aria-hidden="true">▶</span> <%= platform.name %> MARKETPLACE</p><h1><%= title %></h1><p class="catalog-lead"><%= isChannel ? 'Найдите канал под свой проект. Сравните аудиторию, тематику и стоимость.' : 'Найдите исполнителя для своего канала. Сравните предложения и выберите подходящую услугу.' %></p></div>
    <a class="catalog-heading-action" href="<%= sellUrl %>"><span><%= isChannel ? 'Хотите продать канал?' : 'Предлагаете свои услуги?' %></span><strong>Разместить объявление <span aria-hidden="true">↗</span></strong></a>
  </section>
  <div class="catalog-layout">
    <aside class="catalog-sidebar">
      <details class="catalog-categories" open>
        <summary>Категории <span class="pl-chevron" aria-hidden="true"></span></summary>
        <nav aria-label="Категории YouTube">
          <% categories.forEach(item => { %><a href="/market/<%= encodeURIComponent(platform.id) %>/<%= encodeURIComponent(item.id) %>" <%- item.id === category.id ? 'aria-current="page"' : '' %>><span class="category-dot" aria-hidden="true"><%= Number(item.formType) === 1 ? '▶' : '◇' %></span><span><%= item.id === 'channel-buy' ? 'YouTube-каналы' : item.description || item.name %></span><% if (item.id === category.id) { %><span class="category-arrow" aria-hidden="true">›</span><% } %></a><% }); %>
        </nav>
      </details>
      <details class="catalog-filters" open>
        <summary>Фильтры <span class="pl-chevron" aria-hidden="true"></span></summary>
        <form id="catalog-filters" method="get" action="<%= catalogPath %>">
          <fieldset><legend>Цена, $</legend><div class="filter-range"><label><span>От</span><input name="price_min" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0" value="<%= filters.price_min %>"></label><label><span>До</span><input name="price_max" type="number" min="0" step="0.01" inputmode="decimal" placeholder="Любая" value="<%= filters.price_max %>"></label></div></fieldset>
          <% if (isChannel) { %>
            <fieldset><legend>Подписчики</legend><div class="filter-range"><label><span>От</span><input name="subs_min" type="number" min="0" step="1" inputmode="numeric" placeholder="0" value="<%= filters.subs_min %>"></label><label><span>До</span><input name="subs_max" type="number" min="0" step="1" inputmode="numeric" placeholder="Любые" value="<%= filters.subs_max %>"></label></div></fieldset>
            <label class="filter-label" for="filter-theme">Тематика канала</label><select id="filter-theme" name="theme"><option value="">Все тематики</option><% themes.forEach((theme, index) => { %><option value="<%= index + 1 %>" <%- filters.theme === String(index + 1) ? 'selected' : '' %>><%= theme %></option><% }); %></select>
            <details class="advanced-filters" <%- filters.monetized || filters.income_min || filters.income_max ? 'open' : '' %>><summary>Монетизация и доход <span aria-hidden="true">＋</span></summary>
              <label class="filter-label" for="filter-monetized">Монетизация</label><select id="filter-monetized" name="monetized"><option value="">Не имеет значения</option><option value="true" <%- filters.monetized === 'true' ? 'selected' : '' %>>Включена</option><option value="false" <%- filters.monetized === 'false' ? 'selected' : '' %>>Отключена</option></select>
              <fieldset><legend>Доход в месяц, $</legend><div class="filter-range"><label><span>От</span><input name="income_min" type="number" min="0" step="0.01" placeholder="0" value="<%= filters.income_min %>"></label><label><span>До</span><input name="income_max" type="number" min="0" step="0.01" placeholder="Любой" value="<%= filters.income_max %>"></label></div></fieldset>
            </details>
          <% } %>
          <p id="filter-error" class="filter-error" role="alert" <%- errors.length ? '' : 'hidden' %>><%= errors.join(' ') %></p>
          <button class="pl-button filter-apply" type="submit">Применить фильтры</button><a class="filter-reset" href="<%= catalogPath %>">Сбросить всё</a>
        </form>
      </details>
      <div class="catalog-advice"><span aria-hidden="true">✧</span><h2>Выбирайте осознанно</h2><p><%= isChannel ? 'Перед покупкой уточните статистику канала, источники дохода и условия передачи у продавца.' : 'Перед заказом обсудите результат, сроки, стоимость и количество правок с исполнителем.' %></p></div>
    </aside>
    <section class="catalog-results" aria-label="Объявления">
      <div class="catalog-search"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><label class="sr-only" for="catalog-query">Поиск объявлений</label><input id="catalog-query" form="catalog-filters" type="search" name="q" maxlength="120" placeholder="<%= isChannel ? 'Название канала или ключевое слово' : 'Какую услугу вы ищете?' %>" value="<%= filters.q %>"><button class="pl-button" type="submit" form="catalog-filters">Найти</button></div>
      <div class="catalog-toolbar"><p><strong><%= totalCount.toLocaleString('ru-RU') %></strong> объявлений<% if (filters.q) { %><span class="query-caption"> по запросу «<%= filters.q %>»</span><% } %></p><label class="catalog-sort"><span>Сначала</span><select name="sort" form="catalog-filters" aria-label="Сортировка"><% const sorts = { recommended: 'Рекомендуемые', newest: 'Новые', price_asc: 'Дешевле', price_desc: 'Дороже' }; if (isChannel) sorts.subscribers_desc = 'Больше подписчиков'; Object.entries(sorts).forEach(([key, label]) => { %><option value="<%= key %>" <%- filters.sort === key ? 'selected' : '' %>><%= label %></option><% }); %></select></label></div>
      <%- include('partials/catalog-results') %>
    </section>
  </div>
</main>
<%- include('../partials/plgl-footer') %>
<script src="/market/scripts/item/catalog.js?v=2" defer></script>
<script type="module" src="/scripts/favoritesModal/favoritesMain.js?v=media-4"></script>
<script type="module" src="/scripts/settingsModal/main.js?v=security-2"></script>
</body>
</html>
