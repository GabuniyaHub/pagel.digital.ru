# Generate a unique value with at least 32 random characters.
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Google OAuth web client ID (no client secret is needed for ID-token verification).
GOOGLE_CLIENT_ID=

# SMTP credentials. Use a dedicated account and rotate any credentials previously committed.
SMTP_USER=d
SMTP_PASS=
SMTP_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

#other variables
PORT=3000

# Database
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=
DB_PORT=
